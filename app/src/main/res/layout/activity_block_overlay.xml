<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <ImageView
        android:id="@+id/block_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@string/block_title"
        android:src="@drawable/ic_block"
        app:layout_constraintBottom_toTopOf="@id/block_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:tint="@color/focus_low" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/block_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/block_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="@color/white"
        app:layout_constraintBottom_toTopOf="@id/block_target"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/block_icon" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/block_target"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="@color/focus_medium"
        app:layout_constraintBottom_toTopOf="@id/block_message"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/block_title" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/block_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/block_message"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/white"
        app:layout_constraintBottom_toTopOf="@id/btn_back_to_work"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/block_target"
        app:layout_constraintWidth_max="360dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_back_to_work"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:text="@string/block_back_to_work"
        app:layout_constraintBottom_toTopOf="@id/btn_allow_interrupt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/block_message"
        app:layout_constraintWidth_max="360dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_allow_interrupt"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="48dp"
        android:text="@string/block_allow_for"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_back_to_work"
        app:layout_constraintWidth_max="360dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
