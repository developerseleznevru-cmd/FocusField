<?xml version="1.0" encoding="utf-8"?>
<!-- «Аккаунт» — вкладка нижнего меню: карточка текущего аккаунта
     (аватар, ФИО, email) и выход. Раздел вынесен из настроек. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/account_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Аватар: только отображение (смена фото — на экране профиля). -->
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_placeholder" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/account_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/profile_avatar_desc"
                android:scaleType="center"
                android:src="@drawable/ic_person"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FocusField.Circle" />
        </FrameLayout>

        <TextView
            android:id="@+id/account_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/account_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <!-- Толкает кнопку выхода к низу экрана (fillViewport + weight). -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1" />

        <!-- Выход: разрушительное действие — контурная кнопка цвета ошибки. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logout"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/account_logout"
            android:textColor="?attr/colorError"
            app:strokeColor="?attr/colorError" />
    </LinearLayout>
</ScrollView>
